{
  "name": "dumbdrop",
  "version": "1.6.0",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "test": "node --test test/**/*.test.js",
    "predev": "node -e \"const [a,b]=process.versions.node.split('.').map(Number);if(a<22||(a===22&&b<13)){console.error('Node.js >=22.13.0 required');process.exit(1)}\""
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "A simple file upload application",
  "dependencies": {
    "archiver": "^8.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "helmet": "^8.3.0",
    "multer": "^2.5.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-n": "^18.5.0",
    "prettier": "^3.10.0"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "overrides": {
    "minimatch": "^11.0.8"
  }
}
